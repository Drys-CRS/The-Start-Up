# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical public URL, no trailing slash. Drives metadata, sitemap, robots, email
# links, Stripe redirects, and the alias-domain redirect in middleware.ts.
NEXT_PUBLIC_SITE_URL=https://tsu.agency

# Password for /admin and the internal /api/agent + /api/dev routes (HTTP Basic
# auth, any username). If unset, those routes are locked for everyone.
ADMIN_PASSWORD=use-a-long-random-password

# ── AI providers (server-side only) ───────────────────────────────────────────
# OpenRouter — Bottleneck Report; also a fallback for homepage tailoring.
OPENROUTER_API_KEY=sk-or-xxxxxxxx
# Google Gemini — Build Plan auto-fill, domain analysis, MVP planning agent.
GOOGLE_AI_API_KEY=xxxxxxxx
# Vercel AI Gateway — primary provider for homepage tailoring.
AI_GATEWAY_API_KEY=xxxxxxxx

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Signing secret for the webhook endpoint (/api/stripe-webhook).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ── Monday.com ────────────────────────────────────────────────────────────────
# Personal API token (Profile > Developers > My Access Tokens)
MONDAY_API_TOKEN=xxxxxxxx
MONDAY_LEADS_BOARD_ID=18419179018
MONDAY_SCOPE_BOARD_ID=18419179036
MONDAY_DELIVERY_BOARD_ID=18419179069
# Scope Locks "Ref No" text column — powers the /status lookup.
MONDAY_SCOPE_REF_COL=text_mm5b6hh4

# ── Resend (transactional email; sends are skipped if the key is unset) ──────
# The From address must be on a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=The Start Up <hello@tsu.agency>
# Internal inbox for customer "request an update" notifications.
TEAM_NOTIFY_EMAIL=team@tsu.agency
